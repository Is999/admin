-- 代码资产：统计 shardbackfill checkpoint 全部表约束。
-- SQL 方言：MySQL 8.0 information_schema。
-- 调用方：cmd/shardbackfill.validateCheckpointSchema。
-- 参数来源：无动态参数，固定检查运维进度表。
-- 安全边界：只读单表约束元数据；精确数量用于拒绝额外 UNIQUE 或 FOREIGN KEY。
SELECT COUNT(*)
FROM `information_schema`.`TABLE_CONSTRAINTS`
WHERE `CONSTRAINT_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'shard_backfill_checkpoint'
