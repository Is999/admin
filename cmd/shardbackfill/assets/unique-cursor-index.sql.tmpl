-- 代码资产：确认回填游标具有单列唯一索引。
-- SQL 方言：MySQL 8.0 information_schema。
-- 调用方：cmd/shardbackfill.validateTableSchema。
-- 参数来源：表名和游标列名通过预编译参数传入。
-- 安全边界：只读指定表索引元数据，不扫描业务数据。
SELECT COUNT(*)
FROM (
  SELECT `INDEX_NAME`
  FROM `information_schema`.`STATISTICS`
  WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = ? AND `NON_UNIQUE` = 0
  GROUP BY `INDEX_NAME`
  HAVING COUNT(*) = 1 AND MAX(`COLUMN_NAME`) = ?
) AS `single_unique_indexes`
