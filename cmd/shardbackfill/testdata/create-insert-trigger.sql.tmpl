-- 代码资产：创建 shardbackfill 集成测试插入保护触发器。
-- SQL 方言：MySQL 8.0。
-- 调用方：cmd/shardbackfill.createSourceGuards。
-- 参数来源：无动态参数，仅使用固定测试对象名。
-- 安全边界：语义与生产源表插入保护模板保持一致。
CREATE TRIGGER `shard_backfill_case_bi`
AFTER INSERT ON `shard_backfill_case`
FOR EACH ROW
BEGIN
  IF NEW.`id` IS NULL OR NEW.`id` <= 0
     OR NEW.`shard_no` IS NULL
     OR NEW.`uid` IS NULL OR NEW.`uid` <= 0
     OR NEW.`shard_no` <> MOD(CRC32(CAST(NEW.`uid` AS CHAR)), 1024) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'shard_no does not match fixed user bucket';
  END IF;
END
