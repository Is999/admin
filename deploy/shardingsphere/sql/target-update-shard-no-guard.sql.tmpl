-- 目标物理表更新保护：逻辑表建成后、迁移启动前，直连每个实际数据节点逐表创建。
-- 物理表名、主键列、UID列和触发器名必须来自 SHOW SHARDING TABLE NODES 审核清单。
-- lock_wait_timeout 让元数据锁无法快速取得时直接失败；主键、UID 或桶号错误变化会回滚写入。
SET SESSION lock_wait_timeout = 5;

DELIMITER //
CREATE TRIGGER `__UPDATE_TRIGGER__`
BEFORE UPDATE ON `__PHYSICAL_TABLE__`
FOR EACH ROW
BEGIN
  IF NOT (NEW.`__PRIMARY_KEY__` <=> OLD.`__PRIMARY_KEY__`) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'backfill cursor primary key is immutable';
  END IF;
  IF (NOT (NEW.`__UID_COLUMN__` <=> OLD.`__UID_COLUMN__`)
      OR NOT (NEW.`shard_no` <=> OLD.`shard_no`))
     AND (NEW.`shard_no` IS NULL
       OR NEW.`__UID_COLUMN__` IS NULL
       OR NEW.`__UID_COLUMN__` <= 0
       OR NEW.`shard_no` <> MOD(CRC32(CAST(NEW.`__UID_COLUMN__` AS CHAR)), 1024)) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'shard_no does not match fixed user bucket';
  END IF;
END//
DELIMITER ;
