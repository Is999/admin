-- 目标物理表保护核验：直连每个实际数据节点执行并保存结果。
-- 物理表名必须来自 SHOW SHARDING TABLE NODES 审核清单，禁止查询未授权 schema。
-- 结果必须恰好包含一个 AFTER INSERT 和一个 BEFORE UPDATE，ACTION_STATEMENT 与受版本控制模板完整比对。
SELECT `TRIGGER_NAME`, `ACTION_TIMING`, `EVENT_MANIPULATION`, `ACTION_STATEMENT`
FROM `information_schema`.`TRIGGERS`
WHERE `TRIGGER_SCHEMA` = DATABASE() AND `EVENT_OBJECT_TABLE` = '__PHYSICAL_TABLE__'
ORDER BY `ACTION_TIMING`, `EVENT_MANIPULATION`, `TRIGGER_NAME`;
